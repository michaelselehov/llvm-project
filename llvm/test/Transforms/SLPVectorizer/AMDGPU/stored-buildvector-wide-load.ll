; A complex value is loaded as one i64 and split into its real and imaginary
; float halves. The halves are computed separately and packed back into a
; <2 x float> that is stored. Two scalar float stores of the same values give
; <2 x float> arithmetic, and the buildvector must give the same result.

; The i64 load in the operand tree must not make the float lanes 64 bits wide,
; which would allow no vector factor above 1.
define void @stored_bv2_wide_load(ptr addrspace(3) %x, ptr addrspace(3) %out) {
; CHECK-LABEL: @stored_bv2_wide_load(
; CHECK-NEXT:    [[X_P0:%.*]] = getelementptr inbounds i8, ptr addrspace(3) [[X:%.*]], i32 0
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x i64>, ptr addrspace(3) [[X_P0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = extractelement <2 x i64> [[TMP1]], i64 0
; CHECK-NEXT:    [[X_SH0:%.*]] = lshr i64 [[TMP2]], 32
; CHECK-NEXT:    [[TMP3:%.*]] = trunc <2 x i64> [[TMP1]] to <2 x i32>
; CHECK-NEXT:    [[TMP4:%.*]] = trunc i64 [[X_SH0]] to i32
; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <2 x i32> [[TMP3]], i32 [[TMP4]], i64 1
; CHECK-NEXT:    [[TMP6:%.*]] = bitcast <2 x i32> [[TMP5]] to <2 x float>
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <2 x i64> [[TMP1]], i64 1
; CHECK-NEXT:    [[X_SH1:%.*]] = lshr i64 [[TMP7]], 32
; CHECK-NEXT:    [[TMP8:%.*]] = trunc <2 x i64> [[TMP1]] to <2 x i32>
; CHECK-NEXT:    [[TMP9:%.*]] = shufflevector <2 x i32> [[TMP8]], <2 x i32> poison, <2 x i32> <i32 1, i32 poison>
; CHECK-NEXT:    [[TMP10:%.*]] = trunc i64 [[X_SH1]] to i32
; CHECK-NEXT:    [[TMP11:%.*]] = insertelement <2 x i32> [[TMP9]], i32 [[TMP10]], i64 1
; CHECK-NEXT:    [[TMP12:%.*]] = bitcast <2 x i32> [[TMP11]] to <2 x float>
; CHECK-NEXT:    [[TMP13:%.*]] = fadd <2 x float> [[TMP6]], [[TMP12]]
; CHECK-NEXT:    store <2 x float> [[TMP13]], ptr addrspace(3) [[OUT:%.*]], align 8
; CHECK-NEXT:    ret void
;
  %x.p0 = getelementptr inbounds i8, ptr addrspace(3) %x, i32 0
  %x.w0 = load i64, ptr addrspace(3) %x.p0, align 8
  %x.lo0 = trunc i64 %x.w0 to i32
  %x.re0 = bitcast i32 %x.lo0 to float
  %x.sh0 = lshr i64 %x.w0, 32
  %x.hi0 = trunc i64 %x.sh0 to i32
  %x.im0 = bitcast i32 %x.hi0 to float
  %x.p1 = getelementptr inbounds i8, ptr addrspace(3) %x, i32 8
  %x.w1 = load i64, ptr addrspace(3) %x.p1, align 8
  %x.lo1 = trunc i64 %x.w1 to i32
  %x.re1 = bitcast i32 %x.lo1 to float
  %x.sh1 = lshr i64 %x.w1, 32
  %x.hi1 = trunc i64 %x.sh1 to i32
  %x.im1 = bitcast i32 %x.hi1 to float
  %sre = fadd float %x.re0, %x.re1
  %sim = fadd float %x.im0, %x.im1
  %v0 = insertelement <2 x float> poison, float %sre, i64 0
