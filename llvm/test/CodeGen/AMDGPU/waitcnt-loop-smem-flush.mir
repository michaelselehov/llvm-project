  bb.1:
    successors: %bb.1, %bb.2

    $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
    $sgpr11 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 4, 0
    $vgpr3 = V_ADD_U32_e32 $sgpr11, $vgpr2, implicit $exec
    S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...

# The loop contains an SMEM prefetch.
# FIXME: The prefetch writes no register, so the wait can move to the
# preheader.
---
name:            flush_prefetch_in_loop
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; GFX9-LABEL: name: flush_prefetch_in_loop
  ; GFX9: bb.0:
  ; GFX9-NEXT:   successors: %bb.1(0x80000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
  ; GFX9-NEXT:   S_BRANCH %bb.1
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.1:
  ; GFX9-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   S_WAITCNT .Lgkmcnt_0
  ; GFX9-NEXT:   S_PREFETCH_DATA $sgpr2_sgpr3, 0, $sgpr_null, 0, 0
  ; GFX9-NEXT:   $sgpr2_sgpr3 = S_ADD_U64_PSEUDO $sgpr2_sgpr3, 16, implicit-def dead $scc
  ; GFX9-NEXT:   S_CMP_LG_U32 $sgpr4, $sgpr5, implicit-def $scc
  ; GFX9-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX9-NEXT:   S_BRANCH %bb.2
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.2:
  ; GFX9-NEXT:   S_ENDPGM 0
  ;
  ; GFX12-LABEL: name: flush_prefetch_in_loop
  ; GFX12: bb.0:
  ; GFX12-NEXT:   successors: %bb.1(0x80000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
  ; GFX12-NEXT:   S_BRANCH %bb.1
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.1:
  ; GFX12-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   S_WAIT_KMCNT 0
  ; GFX12-NEXT:   S_PREFETCH_DATA $sgpr2_sgpr3, 0, $sgpr_null, 0, 0
  ; GFX12-NEXT:   $sgpr2_sgpr3 = S_ADD_U64_PSEUDO $sgpr2_sgpr3, 16, implicit-def dead $scc
  ; GFX12-NEXT:   S_CMP_LG_U32 $sgpr4, $sgpr5, implicit-def $scc
  ; GFX12-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX12-NEXT:   S_BRANCH %bb.2
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.2:
  ; GFX12-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1

    $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    S_PREFETCH_DATA $sgpr2_sgpr3, 0, $sgpr_null, 0, 0
    $sgpr2_sgpr3 = S_ADD_U64_PSEUDO $sgpr2_sgpr3, 16, implicit-def dead $scc
    S_CMP_LG_U32 $sgpr4, $sgpr5, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...

# The loop contains a call, so the wait in the loop stays.
---
name:            no_flush_call
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; GFX9-LABEL: name: no_flush_call
  ; GFX9: bb.0:
  ; GFX9-NEXT:   successors: %bb.1(0x80000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
  ; GFX9-NEXT:   S_BRANCH %bb.1
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.1:
  ; GFX9-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   S_WAITCNT .Lgkmcnt_0
  ; GFX9-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
  ; GFX9-NEXT:   dead $sgpr30_sgpr31 = SI_CALL $sgpr16_sgpr17, 0, csr_amdgpu
  ; GFX9-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX9-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX9-NEXT:   S_BRANCH %bb.2
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.2:
  ; GFX9-NEXT:   S_ENDPGM 0
  ;
  ; GFX12-LABEL: name: no_flush_call
  ; GFX12: bb.0:
  ; GFX12-NEXT:   successors: %bb.1(0x80000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
  ; GFX12-NEXT:   S_BRANCH %bb.1
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.1:
  ; GFX12-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   S_WAIT_KMCNT 0
  ; GFX12-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
  ; GFX12-NEXT:   dead $sgpr30_sgpr31 = SI_CALL $sgpr16_sgpr17, 0, csr_amdgpu
  ; GFX12-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX12-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX12-NEXT:   S_BRANCH %bb.2
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.2:
  ; GFX12-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1

    $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
    dead $sgpr30_sgpr31 = SI_CALL $sgpr16_sgpr17, 0, csr_amdgpu
    S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
