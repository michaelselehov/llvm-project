  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   $vgpr2 = GLOBAL_LOAD_DWORD $vgpr4_vgpr5, 0, 0, implicit $exec
  ; GFX12-NEXT:   S_WAIT_LOADCNT 0
