# The first user in the header needs only the SMEM wait. Its wait covers the
# later user that also uses a vgpr loaded in the loop.
# FIXME: The wait for the SMEM load can move to the preheader.
---
name:            flush_header_user
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; GFX9-LABEL: name: flush_header_user
  ; GFX9: bb.0:
  ; GFX9-NEXT:   successors: %bb.1(0x80000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   $sgpr10_sgpr11 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
  ; GFX9-NEXT:   $sgpr12 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 8, 0
  ; GFX9-NEXT:   S_BRANCH %bb.1
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.1:
  ; GFX9-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   S_WAITCNT .Lgkmcnt_0
  ; GFX9-NEXT:   $vgpr2 = GLOBAL_LOAD_DWORD_SADDR $sgpr10_sgpr11, $vgpr0, 0, 0, implicit $exec
  ; GFX9-NEXT:   S_WAITCNT .Vmcnt_0
  ; GFX9-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr12, $vgpr2, implicit $exec
  ; GFX9-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX9-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX9-NEXT:   S_BRANCH %bb.2
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.2:
  ; GFX9-NEXT:   S_ENDPGM 0
  ;
  ; GFX12-LABEL: name: flush_header_user
  ; GFX12: bb.0:
  ; GFX12-NEXT:   successors: %bb.1(0x80000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   $sgpr10_sgpr11 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
  ; GFX12-NEXT:   $sgpr12 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 8, 0
  ; GFX12-NEXT:   S_BRANCH %bb.1
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.1:
  ; GFX12-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   S_WAIT_KMCNT 0
  ; GFX12-NEXT:   $vgpr2 = GLOBAL_LOAD_DWORD_SADDR $sgpr10_sgpr11, $vgpr0, 0, 0, implicit $exec
  ; GFX12-NEXT:   S_WAIT_LOADCNT 0
  ; GFX12-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr12, $vgpr2, implicit $exec
  ; GFX12-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX12-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX12-NEXT:   S_BRANCH %bb.2
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.2:
  ; GFX12-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1

    $sgpr10_sgpr11 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
    $sgpr12 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 8, 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    $vgpr2 = GLOBAL_LOAD_DWORD_SADDR $sgpr10_sgpr11, $vgpr0, 0, 0, implicit $exec
    $vgpr1 = V_ADD_U32_e32 $sgpr12, $vgpr2, implicit $exec
    S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...

