# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs -run-pass si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX9 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX12 %s

# The loop uses an sgpr that is loaded by SMEM before the loop.
# FIXME: The wait for the load can move to the preheader.
---
name:            flush
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; GFX9-LABEL: name: flush
  ; GFX9: bb.0:
  ; GFX9-NEXT:   successors: %bb.1(0x80000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
  ; GFX9-NEXT:   S_BRANCH %bb.1
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.1:
  ; GFX9-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT:   S_WAITCNT .Lgkmcnt_0
  ; GFX9-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
  ; GFX9-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX9-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX9-NEXT:   S_BRANCH %bb.2
  ; GFX9-NEXT: {{  $}}
  ; GFX9-NEXT: bb.2:
  ; GFX9-NEXT:   S_ENDPGM 0
  ;
  ; GFX12-LABEL: name: flush
  ; GFX12: bb.0:
  ; GFX12-NEXT:   successors: %bb.1(0x80000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
  ; GFX12-NEXT:   S_BRANCH %bb.1
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.1:
  ; GFX12-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT:   S_WAIT_KMCNT 0
  ; GFX12-NEXT:   $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
  ; GFX12-NEXT:   S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
  ; GFX12-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit killed $scc
  ; GFX12-NEXT:   S_BRANCH %bb.2
  ; GFX12-NEXT: {{  $}}
  ; GFX12-NEXT: bb.2:
  ; GFX12-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1

    $sgpr10 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    $vgpr1 = V_ADD_U32_e32 $sgpr10, $vgpr2, implicit $exec
    S_CMP_LG_U32 $sgpr3, $sgpr4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...

# The user of the sgpr also uses a vgpr that is loaded earlier in the loop.
# The wait stays in the loop, so the preheader gets no wait.
---
